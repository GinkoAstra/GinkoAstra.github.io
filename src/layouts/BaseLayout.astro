---
import "../styles/global.css";
import { SITE, NAV, CATEGORY } from "../config/site";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  active?: string; // NAV key;文章页传分区 key
}

const { title, description = SITE.description, isHome = false, active } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;

const posts = await getCollection("posts");
const records = posts.length;
const today = new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();
const catLine = Object.values(CATEGORY).map((c) => c.label).join(" · ");

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/").replace(/^\//, "").replace(/\/$/, "");
const activeKey = active ?? (path === "" ? "home" : NAV.find((n) => n.route && path.startsWith(n.route))?.key ?? "");
const favicon = import.meta.env.BASE_URL + "favicon.png";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <script is:inline>
      // 首绘前恢复主题,避免明暗闪烁
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class:list={[{ "is-home": isHome }]}>
    <header class="topbar">
      <a class="brand" href={import.meta.env.BASE_URL}>
        <img class="ginkgo" src={favicon} width="20" height="20" alt="" />
        <span>{SITE.name}<span class="sub">{SITE.nameSub}</span></span>
      </a>
      <nav class="nav" id="nav">
        {
          NAV.map((n) => (
            <a
              href={import.meta.env.BASE_URL + n.route}
              class:list={[{ active: n.key === activeKey }]}
            >
              <span class="idx">{n.idx}</span>{n.label}
            </a>
          ))
        }
      </nav>
      <button class="theme-toggle" id="themeToggle" title="切换明暗主题">◐ THEME</button>
    </header>

    <div class="status-strip">
      <span class="live">{SITE.statusLive}</span>
      <span>{today}</span>
      <span>RECORDS: {records}</span>
      <span>{SITE.uplink}</span>
    </div>

    <main class="container" id="app">
      <slot />
    </main>

    <footer class="footer">
      <span>{SITE.name}</span>
      <span class="sep">/</span>
      <span>{catLine}</span>
      <span class="sep">/</span>
      <span>© {year}</span>
      {SITE.icp && <span>{SITE.icp}</span>}
      <span class="right">{SITE.powered}</span>
    </footer>

    {/* 解密转场覆盖层:静态渲染为遮盖态,脚本加载后播"展开" */}
    <div id="wipe" class="on">
      <span class="wipe-bg"></span>
      <span class="wipe-line l1"></span>
      <span class="wipe-line l2"></span>
    </div>

    <script>
      import "../scripts/theme.js";
      import "../scripts/transition.js";
    </script>
  </body>
</html>
